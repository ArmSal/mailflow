@model Mailflow.Domain.Entities.Category
<tr>
    <td class="num">@Model.SortOrder</td>
    <td><span class="cell-name"><span class="swatch" style="background-color:@(System.Text.RegularExpressions.Regex.IsMatch(Model.Color ?? "", "^#[0-9a-fA-F]{6}$") ? Model.Color : "#6c757d")" aria-hidden="true"></span>@Model.Name</span>
        @if (ViewData["Error"] is string err) { <span class="cell-inline-error" role="alert">@err</span> }
    </td>
    <td>@Model.LocalSubfolder</td>
    <td>@Model.ImapFolder</td>
    <td>
        <div class="row-actions row-actions-nowrap">
            <a class="btn btn-sm btn-secondary" asp-page="/Categories/Edit" asp-route-id="@Model.Id">@T("Modifier")</a>
            <form method="post" hx-post="@Url.Page("/Categories/Index", "Delete", new { id = Model.Id })" hx-target="closest tr" hx-swap="outerHTML" hx-confirm="@T("Supprimer cette catégorie ?")">
                <button class="btn btn-sm btn-danger" type="submit">@T("Supprimer")</button>
            </form>
        </div>
    </td>
</tr>
