@using Mailflow.Application.Abstractions
@model Mailflow.Web.Pages.Mailboxes.MsSignInPanel
@{
    var id = Model.MailboxId;
    var waiting = Model.Status.State == OAuthSignInState.WaitingForUser && Model.Status.Code is not null;
    var failed = Model.Status.State == OAuthSignInState.Failed;
    var justDone = Model.Status.State == OAuthSignInState.Succeeded;
    var token = "#mailbox-form input[name=__RequestVerificationToken]";
}
<div id="ms-panel" class="ms-panel" hx-get="@(waiting ? Url.Page("/Mailboxes/Edit", "MsStatus", new { id }) : null)" hx-trigger="@(waiting ? "every 3s" : null)" hx-target="@(waiting ? "#ms-panel" : null)" hx-swap="@(waiting ? "outerHTML" : null)">
    <div class="ms-panel-head">
        <h3 class="ms-panel-title">Connexion Microsoft</h3>
        @if (Model.SignedIn) { <span class="badge badge-ok">Connecté</span> } else { <span class="badge badge-neutral">Non connecté</span> }
    </div>
    @if (id == 0)
    {
        <p class="form-text">Enregistrez d'abord la boîte, puis connectez-la.</p>
    }
    else
    {
        @if (!Model.Configured)
        {
            <div class="alert alert-warning" role="status">L'identifiant d'application Microsoft n'est pas renseigné. Ajoutez-le dans <a href="@Url.Page("/Settings/Index")">Paramètres</a> (voir Docs/microsoft-oauth-setup.md).</div>
        }
        @if (justDone) { <div class="alert alert-success" role="status"><span class="alert-title">Connecté</span>Cette boîte est connectée à son compte Microsoft.</div> }
        @if (failed)
        {
            <div class="alert alert-danger" role="alert"><span class="alert-title">Échec de la connexion</span>@(string.IsNullOrWhiteSpace(Model.Status.Error) ? "La connexion a échoué." : Model.Status.Error)</div>
        }
        @if (waiting)
        {
            var code = Model.Status.Code!;
            var minutes = Math.Max(0, (int)Math.Ceiling((code.ExpiresAtUtc - DateTime.UtcNow).TotalMinutes));
            <div class="ms-code-box" role="status">
                <p class="ms-code-intro">Ouvrez cette page sur n'importe quel appareil, saisissez le code, puis connectez-vous avec le compte Microsoft de cette boîte.</p>
                <div class="ms-code" aria-label="Code à saisir">@code.UserCode</div>
                <p class="ms-url"><span class="ms-url-text">@code.VerificationUrl</span>
                    <a class="btn btn-sm btn-secondary" href="@code.VerificationUrl" target="_blank" rel="noopener">Ouvrir la page</a></p>
                <p class="form-text">Ce code expire à @code.ExpiresAtUtc.ToLocalTime().ToString("HH:mm") (dans environ @minutes min). En attente de votre connexion…</p>
            </div>
        }
        @if (Model.SignedIn || !waiting)
        {
        <div class="ms-actions">
            @if (Model.SignedIn)
            {
                <button type="button" class="btn btn-secondary" hx-post="@Url.Page("/Mailboxes/Edit", "MsSignOut", new { id })" hx-include="@token" hx-target="#ms-panel" hx-swap="outerHTML" hx-confirm="Déconnecter cette boîte de son compte Microsoft ?">Déconnecter</button>
            }
            else if (!waiting)
            {
                <button type="button" class="btn btn-primary" hx-post="@Url.Page("/Mailboxes/Edit", "MsStart", new { id })" hx-include="@token" hx-target="#ms-panel" hx-swap="outerHTML">@(failed ? "Réessayer" : "Se connecter avec Microsoft")</button>
            }
        </div>
        }
    }
</div>
