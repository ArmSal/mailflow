@model Mailflow.Domain.Entities.Mailbox
<tr>
    <td><strong>@Model.DisplayName</strong><span class="cell-sub">@Model.Email</span>
        @if (ViewData["Error"] is string err) { <span class="cell-inline-error" role="alert">@err</span> }
        @if (!string.IsNullOrEmpty(Model.LastError)) { <span class="cell-inline-warn">@Model.LastError</span> }
    </td>
    <td>@ViewData["StoreName"]</td>
    <td class="text-nowrap">@(Model.LastCheckAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
    <td>
        <form method="post" hx-post="@Url.Page("/Mailboxes/Index", "Toggle", new { id = Model.Id })" hx-target="closest tr" hx-swap="outerHTML">
            <button class="badge-toggle @(Model.IsActive ? "badge-ok" : "badge-neutral")" type="submit" title="@(Model.IsActive ? "Cliquer pour désactiver" : "Cliquer pour activer")">@(Model.IsActive ? "Actif" : "Inactif")</button>
        </form>
    </td>
    <td>
        <div class="row-actions row-actions-nowrap">
            <a class="btn btn-sm btn-secondary" asp-page="/Mailboxes/Edit" asp-route-id="@Model.Id">Modifier</a>
            <form method="post" hx-post="@Url.Page("/Mailboxes/Index", "Delete", new { id = Model.Id })" hx-target="closest tr" hx-swap="outerHTML" hx-confirm="Supprimer cette boîte mail ?">
                <button class="btn btn-sm btn-danger" type="submit">Supprimer</button>
            </form>
        </div>
    </td>
</tr>
