@page "{id:int?}"
@using Mailflow.Domain.Enums
@{
    var isNew = Request.RouteValues["id"] is null;
    var serverOpen = (ViewData.ModelState.TryGetValue("Input.Host", out var hs) && hs.Errors.Count > 0)
        || (ViewData.ModelState.TryGetValue("Input.Port", out var ps) && ps.Errors.Count > 0);
}
@using Mailflow.Web.Pages.Mailboxes
@model Mailflow.Web.Pages.Mailboxes.EditModel
@{ ViewData["Title"] = T("Boîte mail"); }
<link rel="stylesheet" href="~/css/page-config.css" asp-append-version="true" />
<div class="page-header">
    <div>
        <h1 class="page-title">@T("Boîte mail")</h1>
        <p class="page-subtitle">@T("Connexion IMAP et réglages de la relève.")</p>
    </div>
</div>
<form method="post" id="mailbox-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <section class="form-section">
        <h2 class="form-section-title">@T("Connexion")</h2>
        <p class="form-section-hint">@T("Adresse e-mail et mot de passe de la boîte. Le mot de passe n'est jamais réaffiché une fois enregistré.")</p>
        <div class="field"><label class="form-label" asp-for="Input.Email">@T("Adresse e-mail")</label><input class="form-control" asp-for="Input.Email" autocomplete="off" autofocus /><span class="field-validation-error" asp-validation-for="Input.Email"></span></div>
        <div class="field"><label class="form-label" for="Input_Password">@T("Mot de passe")</label>
            <input type="password" class="form-control" id="Input_Password" name="Input.Password" autocomplete="new-password" placeholder="@(isNew ? "" : T("Laisser vide pour conserver l'actuel"))" />
            <span class="form-text">@T("Mot de passe d'application requis pour iCloud, Gmail et Yahoo.")</span>
            <span class="field-validation-error" asp-validation-for="Input.Password"></span></div>
        <div class="field"><label class="form-label" asp-for="Input.DisplayName">@T("Nom affiché")</label><input class="form-control" asp-for="Input.DisplayName" /><span class="field-validation-error" asp-validation-for="Input.DisplayName"></span></div>
        <input type="hidden" id="Input_UseSsl" name="Input.UseSsl" value="@(Model.Input.UseSsl ? "true" : "false")" />
        @if (!string.IsNullOrEmpty(Model.Input.Username) && !string.Equals(Model.Input.Username, Model.Input.Email, StringComparison.OrdinalIgnoreCase))
        {
            <input type="hidden" name="Input.Username" value="@Model.Input.Username" />
        }
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" role="switch" id="server-toggle" checked="@serverOpen" aria-controls="server-settings" />
            <label class="form-check-label" for="server-toggle">@T("Options avancées")</label>
        </div>
        <p class="form-text" id="provider-hint" aria-live="polite"></p>
        <div id="server-settings" hidden="@(!serverOpen)">
            <div class="field"><label class="form-label" for="preset">@T("Fournisseur")</label>
                <select class="form-select" id="preset">
                    <option value="">@T("Choisir…")</option>
                    @foreach (var p in ProviderPresets.All)
                    {
                        var selected = !string.IsNullOrEmpty(p.Host) && string.Equals(p.Host, Model.Input.Host, StringComparison.OrdinalIgnoreCase);
                        <option value="@p.Key" selected="@selected" data-host="@p.Host" data-port="@p.Port" data-ssl="@(p.UseSsl ? "1" : "0")" data-domains="@p.Domains">@T(p.Label)</option>
                    }
                </select></div>
            <div class="form-grid">
                <div class="field"><label class="form-label" asp-for="Input.Host">@T("Serveur IMAP")</label><input class="form-control" asp-for="Input.Host" /><span class="field-validation-error" asp-validation-for="Input.Host"></span></div>
                <div class="field"><label class="form-label" asp-for="Input.Port">@T("Port")</label><input type="number" class="form-control" asp-for="Input.Port" /><span class="field-validation-error" asp-validation-for="Input.Port"></span></div>
            </div>
        </div>
        <div class="field">
            <div><button type="button" class="btn btn-secondary" hx-post="@Url.Page("/Mailboxes/Edit", "Test", new { id = Request.RouteValues["id"] })" hx-include="#mailbox-form" hx-target="#test-result" hx-disabled-elt="this">@T("Tester la connexion")</button></div>
            <div id="test-result" class="mt-2" aria-live="polite"></div>
        </div>
    </section>
    <section class="form-section">
        <h2 class="form-section-title">@T("Relève")</h2>
        <p class="form-section-hint">@T("Quand et comment les messages sont traités.")</p>
        <div class="form-grid form-grid-2">
            <div class="field"><label class="form-label" asp-for="Input.InboxFolder">@T("Dossier à relever")</label><input class="form-control" asp-for="Input.InboxFolder" /></div>
            <div class="field"><label class="form-label" asp-for="Input.DefaultAfterProcessing">@T("Après traitement")</label>
                <select class="form-select" asp-for="Input.DefaultAfterProcessing">
                    <option value="@AfterProcessing.Leave">@T("Laisser tel quel")</option>
                    <option value="@AfterProcessing.MarkRead">@T("Marquer comme lu")</option>
                    <option value="@AfterProcessing.Move">@T("Déplacer")</option>
                </select></div>
            <div class="field"><label class="form-label" asp-for="Input.CheckIntervalMinutes">@T("Intervalle (min)")</label><input type="number" class="form-control" asp-for="Input.CheckIntervalMinutes" /><span class="field-validation-error" asp-validation-for="Input.CheckIntervalMinutes"></span></div>
            <div class="field"><label class="form-label" asp-for="Input.LookbackDays">@T("Historique (jours)")</label><input type="number" class="form-control" asp-for="Input.LookbackDays" /><span class="form-text">@T("Ancienneté maximale des messages relevés.")</span><span class="field-validation-error" asp-validation-for="Input.LookbackDays"></span></div>
        </div>
        <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" role="switch" asp-for="Input.IsActive" /><label class="form-check-label" asp-for="Input.IsActive">@T("Actif")</label></div>
    </section>
    <div class="form-actions form-actions-sticky"><button class="btn btn-primary" type="submit">@T("Enregistrer")</button><a class="btn btn-ghost" asp-page="Index">@T("Annuler")</a></div>
</form>
@section Scripts {
<script>
(function () {
    var $ = function (id) { return document.getElementById(id); };
    var email = $('Input_Email'), name = $('Input_DisplayName'), host = $('Input_Host'), port = $('Input_Port'), ssl = $('Input_UseSsl');
    var preset = $('preset'), toggle = $('server-toggle'), panel = $('server-settings'), hint = $('provider-hint');
    var nameAuto = !name.value, hostAuto = false, timer;

    function setOpen(open) { toggle.checked = open; panel.hidden = !open; }

    function showHint() {
        var o = preset.selectedOptions[0];
        var known = o && o.value ? ' (' + o.value + ')' : '';
        hint.textContent = host.value ? @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T("Serveur :"))) + ' ' + host.value + ':' + port.value + known : '';
    }

    function domainOf() {
        var v = (email.value || '').trim().toLowerCase(), at = v.lastIndexOf('@@');
        return at < 0 ? '' : v.slice(at + 1);
    }

    function applyPreset(o) {
        if (o.dataset.host) host.value = o.dataset.host;
        port.value = o.dataset.port;
        ssl.value = o.dataset.ssl === '1' ? 'true' : 'false';
    }

    function detect() {
        var d = domainOf();
        for (var i = 0; i < preset.options.length; i++) {
            var o = preset.options[i];
            if (o.dataset.domains && o.dataset.domains.split(',').indexOf(d) >= 0) {
                if (host.value && !hostAuto) return;
                preset.selectedIndex = i;
                applyPreset(o);
                hostAuto = true;
                showHint();
                return;
            }
        }
        if (hostAuto) { host.value = ''; preset.selectedIndex = 0; hostAuto = false; }
        showHint();
    }

    function onEmailDone() {
        detect();
        if (!host.value.trim() && domainOf().indexOf('.') > 0) {
            setOpen(true);
            hint.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T("Fournisseur non reconnu : choisissez-le ou saisissez le serveur IMAP.")));
        }
    }

    email.addEventListener('input', function () {
        if (nameAuto) name.value = email.value.trim();
        clearTimeout(timer);
        timer = setTimeout(detect, 250);
    });
    email.addEventListener('change', onEmailDone);
    name.addEventListener('input', function () { nameAuto = false; });
    host.addEventListener('input', function () { hostAuto = false; showHint(); });
    port.addEventListener('input', showHint);
    preset.addEventListener('change', function () {
        var o = this.selectedOptions[0];
        if (o && o.value) { applyPreset(o); hostAuto = false; }
        showHint();
    });
    toggle.addEventListener('change', function () { panel.hidden = !toggle.checked; });
    showHint();
})();
</script>
}
