@page
@model Mailflow.Web.Pages.Mailboxes.IndexModel
@{ ViewData["Title"] = "Boîtes mail"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Boîtes mail</h1>
    <a class="btn btn-primary" asp-page="Edit">Ajouter une boîte mail</a>
</div>
<table class="table align-middle">
    <thead><tr><th>Nom</th><th>Adresse</th><th>Magasin</th><th>Dernière relève</th><th>Actif</th><th></th></tr></thead>
    <tbody>
    @foreach (var m in Model.Items)
    {
        ViewData["StoreName"] = Model.StoreNames.GetValueOrDefault(m.StoreId);
        <partial name="_MailboxRow" model="m" view-data="ViewData" />
    }
    </tbody>
</table>
