@page
@model Mailflow.Web.Pages.Mailboxes.IndexModel
@{ ViewData["Title"] = "Boîtes mail"; }
<link rel="stylesheet" href="~/css/page-config.css" asp-append-version="true" />
<div class="page-header">
    <div>
        <h1 class="page-title">Boîtes mail</h1>
        <p class="page-subtitle">Les boîtes relevées automatiquement pour en extraire les documents.</p>
    </div>
    <div class="page-actions"><a class="btn btn-primary" asp-page="Edit"><svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>Ajouter une boîte mail</a></div>
</div>
@if (!Model.Items.Any())
{
    <div class="card"><div class="empty-state">
        <span class="empty-state-icon"><svg class="icon" aria-hidden="true"><use href="#i-inbox" /></svg></span>
        <h2 class="empty-state-title">Aucune boîte mail</h2>
        <p>Ajoutez une boîte mail pour que Mailflow relève ses messages et en archive les documents.</p>
        <a class="btn btn-primary" asp-page="Edit">Ajouter une boîte mail</a>
    </div></div>
}
else
{
<div class="table-wrap">
    <table class="table align-middle">
        <thead><tr><th scope="col">Nom</th><th scope="col">Magasin</th><th scope="col">Dernière relève</th><th scope="col">Statut</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
        @foreach (var m in Model.Items)
        {
            ViewData["StoreName"] = Model.StoreNames.GetValueOrDefault(m.StoreId);
            <partial name="_MailboxRow" model="m" view-data="ViewData" />
        }
        </tbody>
    </table>
</div>
}
