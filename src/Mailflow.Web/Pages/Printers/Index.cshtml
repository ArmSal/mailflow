@page
@model Mailflow.Web.Pages.Printers.IndexModel
@{ ViewData["Title"] = "Imprimantes"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Imprimantes</h1>
    <a class="btn btn-primary" asp-page="Edit">Ajouter une imprimante</a>
</div>
<table class="table align-middle">
    <thead><tr><th>Nom</th><th>Imprimante Windows</th><th>Magasin</th><th>Copies</th><th>Recto-verso</th><th>Actif</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.Items)
    {
        ViewData["StoreName"] = Model.StoreNames.GetValueOrDefault(p.StoreId);
        <partial name="_PrinterRow" model="p" view-data="ViewData" />
    }
    </tbody>
</table>
