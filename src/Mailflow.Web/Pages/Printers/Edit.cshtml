@page "{id:int?}"
@using Mailflow.Domain.Enums
@model Mailflow.Web.Pages.Printers.EditModel
@{ ViewData["Title"] = "Imprimante"; }
<link rel="stylesheet" href="~/css/page-config.css" asp-append-version="true" />
<div class="page-header">
    <div>
        <h1 class="page-title">Imprimante</h1>
        <p class="page-subtitle">Associez une imprimante Windows à un magasin.</p>
    </div>
</div>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <section class="form-section">
        <h2 class="form-section-title">Imprimante</h2>
        <p class="form-section-hint">Le nom Windows doit correspondre exactement à celui du système.</p>
        <div class="form-grid">
            <div class="field"><label class="form-label" asp-for="Input.StoreId">Magasin</label>
                <select class="form-select" asp-for="Input.StoreId" asp-items="@(new SelectList(Model.Stores, "Id", "Name"))"></select>
                <span class="field-validation-error" asp-validation-for="Input.StoreId"></span></div>
            <div class="field"><label class="form-label" asp-for="Input.DisplayName">Nom affiché</label><input class="form-control" asp-for="Input.DisplayName" /><span class="field-validation-error" asp-validation-for="Input.DisplayName"></span></div>
        </div>
        <div class="field"><label class="form-label" asp-for="Input.WindowsName">Imprimante Windows</label>
            <div class="field-inline">
                <input class="form-control" asp-for="Input.WindowsName" />
                <button type="button" class="btn btn-secondary" hx-post="@Url.Page("/Printers/Edit", "Detect")" hx-include="closest form" hx-target="#detected">Détecter les imprimantes</button>
            </div>
            <span class="field-validation-error" asp-validation-for="Input.WindowsName"></span>
            <div id="detected" aria-live="polite"></div></div>
        <div class="field"><label class="form-label" asp-for="Input.Kind">Type</label>
            <select class="form-select" asp-for="Input.Kind" asp-items="@Html.GetEnumSelectList<PrinterKind>()"></select></div>
    </section>
    <section class="form-section">
        <h2 class="form-section-title">Impression</h2>
        <p class="form-section-hint">Valeurs appliquées par défaut aux documents imprimés.</p>
        <div class="field"><label class="form-label" asp-for="Input.DefaultCopies">Copies par défaut</label><input type="number" min="1" max="99" class="form-control" asp-for="Input.DefaultCopies" /><span class="field-validation-error" asp-validation-for="Input.DefaultCopies"></span></div>
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" role="switch" asp-for="Input.Duplex" /><label class="form-check-label" asp-for="Input.Duplex">Recto-verso</label></div>
        <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" role="switch" asp-for="Input.IsActive" /><label class="form-check-label" asp-for="Input.IsActive">Actif</label></div>
    </section>
    <div class="form-actions form-actions-sticky"><button class="btn btn-primary" type="submit">Enregistrer</button><a class="btn btn-ghost" asp-page="Index">Annuler</a></div>
</form>
@section Scripts {
<script>
document.getElementById('detected').addEventListener('click', function (e) {
    var b = e.target.closest('[data-printer]');
    if (b) document.getElementById('Input_WindowsName').value = b.dataset.printer;
});
</script>
}
