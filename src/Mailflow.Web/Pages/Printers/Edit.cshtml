@page "{id:int?}"
@using Mailflow.Domain.Enums
@model Mailflow.Web.Pages.Printers.EditModel
@{ ViewData["Title"] = "Imprimante"; }
<h1 class="h3 mb-3">Imprimante</h1>
<form method="post" class="col-md-6">
    <div class="mb-3"><label class="form-label" asp-for="Input.StoreId">Magasin</label>
        <select class="form-select" asp-for="Input.StoreId" asp-items="@(new SelectList(Model.Stores, "Id", "Name"))"></select>
        <span class="text-danger" asp-validation-for="Input.StoreId"></span></div>
    <div class="mb-3"><label class="form-label" asp-for="Input.DisplayName">Nom affiché</label><input class="form-control" asp-for="Input.DisplayName" /><span class="text-danger" asp-validation-for="Input.DisplayName"></span></div>
    <div class="mb-3"><label class="form-label" asp-for="Input.WindowsName">Imprimante Windows</label>
        <div class="input-group">
            <input class="form-control" asp-for="Input.WindowsName" />
            <button type="button" class="btn btn-outline-secondary" hx-post="@Url.Page("/Printers/Edit", "Detect")" hx-include="closest form" hx-target="#detected">Détecter les imprimantes</button>
        </div>
        <span class="text-danger" asp-validation-for="Input.WindowsName"></span>
        <div id="detected" class="mt-2"></div></div>
    <div class="mb-3"><label class="form-label" asp-for="Input.Kind">Type</label>
        <select class="form-select" asp-for="Input.Kind" asp-items="@Html.GetEnumSelectList<PrinterKind>()"></select></div>
    <div class="mb-3"><label class="form-label" asp-for="Input.DefaultCopies">Copies par défaut</label><input type="number" min="1" max="99" class="form-control" asp-for="Input.DefaultCopies" /><span class="text-danger" asp-validation-for="Input.DefaultCopies"></span></div>
    <div class="form-check mb-2"><input class="form-check-input" asp-for="Input.Duplex" /><label class="form-check-label" asp-for="Input.Duplex">Recto-verso</label></div>
    <div class="form-check mb-3"><input class="form-check-input" asp-for="Input.IsActive" /><label class="form-check-label" asp-for="Input.IsActive">Actif</label></div>
    <button class="btn btn-primary" type="submit">Enregistrer</button>
    <a class="btn btn-link" asp-page="Index">Annuler</a>
</form>
@section Scripts {
<script>
document.getElementById('detected').addEventListener('click', function (e) {
    var b = e.target.closest('[data-printer]');
    if (b) document.getElementById('Input_WindowsName').value = b.dataset.printer;
});
</script>
}
