@model Mailflow.Domain.Entities.Printer
<tr>
    <td><strong>@Model.DisplayName</strong><span class="cell-sub">@Model.WindowsName</span>
        @if (ViewData["Error"] is string err) { <span class="cell-inline-error" role="alert">@err</span> }
    </td>
    <td class="text-nowrap">@Model.DefaultCopies @(Model.DefaultCopies > 1 ? T("copies") : T("copie"))<span class="cell-sub">@(Model.Duplex ? T("Recto-verso") : T("Recto seul"))</span></td>
    <td>
        <form method="post" hx-post="@Url.Page("/Printers/Index", "Toggle", new { id = Model.Id })" hx-target="closest tr" hx-swap="outerHTML">
            <button class="badge-toggle @(Model.IsActive ? "badge-ok" : "badge-neutral")" type="submit" title="@(Model.IsActive ? T("Cliquer pour désactiver") : T("Cliquer pour activer"))">@(Model.IsActive ? T("Actif") : T("Inactif"))</button>
        </form>
    </td>
    <td>
        <div class="row-actions row-actions-nowrap">
            <form method="post" hx-post="@Url.Page("/Printers/Index", "TestPrint", new { id = Model.Id })" hx-target="next .test-result" hx-swap="innerHTML">
                <button class="btn btn-sm btn-secondary" type="submit">@T("Test d'impression")</button>
            </form>
            <a class="btn btn-sm btn-secondary" asp-page="/Printers/Edit" asp-route-id="@Model.Id">@T("Modifier")</a>
            <form method="post" hx-post="@Url.Page("/Printers/Index", "Delete", new { id = Model.Id })" hx-target="closest tr" hx-swap="outerHTML" hx-confirm="@T("Supprimer cette imprimante ?")">
                <button class="btn btn-sm btn-danger" type="submit">@T("Supprimer")</button>
            </form>
        </div>
        <div class="test-result" aria-live="polite"></div>
    </td>
</tr>


