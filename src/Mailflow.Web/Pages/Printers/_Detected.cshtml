@model IReadOnlyList<string>
@if (Model.Count == 0)
{
    <div class="text-muted">Aucune imprimante détectée.</div>
}
else
{
    <div class="list-group">
    @foreach (var n in Model)
    {
        <button type="button" class="list-group-item list-group-item-action py-1" data-printer="@n">@n</button>
    }
    </div>
}
