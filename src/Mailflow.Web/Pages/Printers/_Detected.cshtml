@model IReadOnlyList<string>
@if (Model.Count == 0)
{
    <div class="alert alert-warning mb-0" role="status">@T("Aucune imprimante détectée sur cet ordinateur.")</div>
}
else
{
    <p class="form-text mb-1">@T("{0} imprimante(s) détectée(s). Cliquez sur l'une d'elles pour la choisir.", Model.Count)</p>
    <div class="detected-list">
    @foreach (var n in Model)
    {
        <button type="button" class="btn btn-sm btn-secondary" data-printer="@n">@n</button>
    }
    </div>
}
