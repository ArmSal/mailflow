@page
@model Mailflow.Web.Pages.Rules.AllowedSendersModel
@{ ViewData["Title"] = "Expéditeurs autorisés"; var names = Model.Stores.ToDictionary(s => s.Id, s => s.Name); }
<link rel="stylesheet" href="~/css/page-activity.css" asp-append-version="true" />
<div class="page-header">
    <div>
        <h1 class="page-title">Expéditeurs autorisés</h1>
        <p class="page-subtitle">Seuls les e-mails de ces expéditeurs (adresse ou domaine) peuvent déclencher une impression.</p>
    </div>
    <div class="page-actions"><a class="btn btn-secondary" asp-page="Index">Retour aux règles</a></div>
</div>
<form method="post" asp-page-handler="Add" class="toolbar" aria-label="Ajouter un expéditeur autorisé">
    <div class="field field-lg">
        <label class="form-label" asp-for="Pattern">Adresse ou domaine</label>
        <input class="form-control" asp-for="Pattern" placeholder="adresse@supplier.example" />
        <span class="field-validation-error" asp-validation-for="Pattern"></span>
    </div>
    <div class="field field-md">
        <label class="form-label" asp-for="StoreId">Magasin</label>
        <select class="form-select" asp-for="StoreId" asp-items="@(new SelectList(Model.Stores, "Id", "Name"))"><option value="">Tous les magasins</option></select>
    </div>
    <div class="toolbar-end"><button class="btn btn-primary" type="submit"><svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>Ajouter</button></div>
</form>
@if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state-icon"><svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg></span>
            <h2 class="empty-state-title">Aucun expéditeur autorisé</h2>
            <p>Ajoutez une adresse ou un domaine pour permettre l'impression automatique de ses documents.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table align-middle">
            <thead><tr><th scope="col">Motif</th><th scope="col">Magasin</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
            @foreach (var a in Model.Items)
            {
                <tr>
                    <td>@a.Pattern</td>
                    <td>@(a.StoreId is int sid && names.TryGetValue(sid, out var n) ? n : "Tous")</td>
                    <td>
                        <div class="row-actions">
                            <form method="post" hx-post="@Url.Page("/Rules/AllowedSenders", "Delete", new { id = a.Id })" hx-target="closest tr" hx-swap="outerHTML" hx-confirm="Retirer cet expéditeur ?">
                                <button class="btn btn-sm btn-danger" type="submit">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}


