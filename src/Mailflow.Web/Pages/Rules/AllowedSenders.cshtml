@page
@model Mailflow.Web.Pages.Rules.AllowedSendersModel
@{ ViewData["Title"] = "Expéditeurs autorisés"; var names = Model.Stores.ToDictionary(s => s.Id, s => s.Name); }
<h1 class="h3 mb-3">Expéditeurs autorisés</h1>
<p class="text-muted">Seuls les e-mails de ces expéditeurs (adresse ou domaine) peuvent déclencher une impression.</p>
<form method="post" asp-page-handler="Add" class="row g-2 mb-4">
    <div class="col-md-5"><input class="form-control" asp-for="Pattern" placeholder="adresse@exemple.fr ou exemple.fr" aria-label="Motif" /><span class="text-danger" asp-validation-for="Pattern"></span></div>
    <div class="col-md-4">
        <select class="form-select" asp-for="StoreId" asp-items="@(new SelectList(Model.Stores, "Id", "Name"))" aria-label="Magasin"><option value="">Tous les magasins</option></select>
    </div>
    <div class="col-md-3"><button class="btn btn-primary" type="submit">Ajouter</button></div>
</form>
<table class="table align-middle">
    <thead><tr><th>Motif</th><th>Magasin</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model.Items)
    {
        <tr>
            <td>@a.Pattern</td>
            <td>@(a.StoreId is int sid && names.TryGetValue(sid, out var n) ? n : "Tous")</td>
            <td class="text-end">
                <form method="post" hx-post="@Url.Page("/Rules/AllowedSenders", "Delete", new { id = a.Id })" hx-target="closest tr" hx-swap="outerHTML" hx-confirm="Retirer cet expéditeur ?">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
