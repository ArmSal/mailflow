@using Mailflow.Domain.Enums
@using Mailflow.Web.Pages.Rules
@model ConditionRowVm
@{ var p = $"Input.Conditions[{Model.Key}]"; var k = "c-" + Model.Key; }
<div class="repeat-row row-item">
    <input type="hidden" name="Input.Conditions.Index" value="@Model.Key" />
    <div class="repeat-fields repeat-fields--cond">
        <div>
            <label class="form-label" for="@(k)-field">@T("Champ")</label>
            <select class="form-select" id="@(k)-field" name="@(p).Field">
                @foreach (var kv in RuleLabels.Fields) { <option value="@kv.Key" selected="@(kv.Key == Model.C.Field)">@kv.Value</option> }
            </select>
        </div>
        <div>
            <label class="form-label" for="@(k)-op">@T("Opérateur")</label>
            <select class="form-select" id="@(k)-op" name="@(p).Operator">
                @foreach (var kv in RuleLabels.Operators) { <option value="@kv.Key" selected="@(kv.Key == Model.C.Operator)">@kv.Value</option> }
            </select>
        </div>
        <div>
            <label class="form-label" for="@(k)-value">@T("Valeur")</label>
            <input class="form-control" id="@(k)-value" name="@(p).Value" value="@Model.C.Value" />
        </div>
        <div class="form-check"><input type="checkbox" class="form-check-input" id="@(k)-case" name="@(p).CaseSensitive" value="true" checked="@Model.C.CaseSensitive" /><input type="hidden" name="@(p).CaseSensitive" value="false" /><label class="form-check-label" for="@(k)-case">@T("Respecter la casse")</label></div>
    </div>
    <button type="button" class="btn btn-sm btn-danger repeat-remove" onclick="this.closest('.row-item').remove()" aria-label="@T("Retirer la condition")" title="@T("Retirer la condition")"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg>@T("Retirer")</button>
</div>

