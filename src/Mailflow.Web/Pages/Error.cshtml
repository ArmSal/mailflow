@page
@model ErrorModel
@{
    ViewData["Title"] = T("Erreur");
}

<div class="auth-panel">
    <h1>@T("Une erreur est survenue")</h1>
    <p class="lead-text">@T("La demande n'a pas pu être traitée. Réessayez ; si le problème persiste, consultez le journal.")</p>
    @if (Model.ShowRequestId)
    {
        <p class="small mb-3">@T("Identifiant de la requête :") <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" href="~/">@T("Retour à l'accueil")</a>
</div>
