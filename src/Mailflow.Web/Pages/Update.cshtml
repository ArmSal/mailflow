@page
@model Mailflow.Web.Pages.UpdateModel
@{ ViewData["Title"] = T("Mise à jour"); }
<div class="page-header"><h1 class="page-title">@T("Mise à jour")</h1></div>
<section class="form-section">
    @if (Model.Started)
    {
        <div class="alert alert-success" role="status">@T("Mise à jour lancée. Mailflow va se fermer puis redémarrer dans la zone de notification ; rouvrez-le dans une minute.")</div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
        <a class="btn btn-ghost" href="~/">@T("Retour")</a>
    }
</section>
