@page
@model SetupModel
@{
    ViewData["Title"] = "Première configuration";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Première configuration</h1>
        <p>Choisissez le mot de passe administrateur du tableau de bord.</p>
        <form method="post">
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mot de passe (8 caractères minimum)</label>
                <input asp-for="Password" class="form-control" autofocus autocomplete="new-password" />
            </div>
            <div class="mb-3">
                <label asp-for="Confirm" class="form-label">Confirmation</label>
                <input asp-for="Confirm" class="form-control" autocomplete="new-password" />
            </div>
            @if (Model.Error is not null)
            {
                <div class="alert alert-danger">@Model.Error</div>
            }
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </form>
    </div>
</div>
