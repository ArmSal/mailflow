@page
@model SetupModel
@{
    ViewData["Title"] = T("Première configuration");
}

<div class="auth-panel">
    <h1>@T("Première configuration")</h1>
    <p class="lead-text">@T("Choisissez le mot de passe administrateur du tableau de bord.")</p>
    <form method="post">
        <div class="field">
            <label asp-for="Password" class="form-label">@T("Mot de passe")</label>
            <input asp-for="Password" class="form-control" autofocus autocomplete="new-password" />
            <div class="form-text">@T("8 caractères minimum.")</div>
        </div>
        <div class="field">
            <label asp-for="Confirm" class="form-label">@T("Confirmation")</label>
            <input asp-for="Confirm" class="form-control" autocomplete="new-password" />
        </div>
        @if (Model.Error is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.Error</div>
        }
        <button type="submit" class="btn btn-primary w-100">@T("Enregistrer")</button>
    </form>
</div>
