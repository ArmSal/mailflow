@page
@model LoginModel
@{
    ViewData["Title"] = T("Connexion");
}

<div class="auth-panel">
    <h1>@T("Connexion")</h1>
    <p class="lead-text">@T("Saisissez le mot de passe du tableau de bord.")</p>
    <form method="post">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div class="field">
            <label asp-for="Password" class="form-label">@T("Mot de passe")</label>
            <input asp-for="Password" class="form-control" autofocus autocomplete="current-password" />
        </div>
        @if (Model.Error is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.Error</div>
        }
        <button type="submit" class="btn btn-primary w-100">@T("Se connecter")</button>
    </form>
</div>
