@page
@model LogoutModel
@{
    ViewData["Title"] = T("Déconnexion");
}

<div class="page-header"><h1 class="page-title">@T("Déconnexion")</h1></div>
<form method="post" class="form-section">
    <p>@T("Se déconnecter de Mailflow ?")</p>
    <div class="form-actions mb-3">
        <button type="submit" class="btn btn-primary">@T("Déconnexion")</button>
        <a class="btn btn-ghost" href="~/">@T("Annuler")</a>
    </div>
</form>
