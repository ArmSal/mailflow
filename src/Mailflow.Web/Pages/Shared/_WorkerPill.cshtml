@using Mailflow.Web.Worker
@model WorkerState
@{
    var state = Model.IsPaused ? "paused" : Model.IsRunning ? "running" : "idle";
    var label = Model.IsPaused ? "En pause" : Model.IsRunning ? "Relève en cours" : "En attente";
    var oob = ViewData["Oob"] as bool? == true;
}
<span id="worker-pill" class="worker-pill" data-state="@state" role="status" aria-label="État du traitement : @label"
      hx-swap-oob="@(oob ? "true" : null)">@label</span>
