@inject Mailflow.Web.Worker.WorkerState Worker
@{
    var authed = User.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value ?? "/";
    var groups = new (string Title, (string Url, string Label, string Icon)[] Items)[]
    {
        ("Tableau de bord", [("/", "Accueil", "home")]),
        ("Configuration", [("/Stores", "Magasins", "store"), ("/Mailboxes", "Boîtes mail", "inbox"), ("/Printers", "Imprimantes", "printer"),
            ("/Categories", "Catégories", "tag"), ("/Rules", "Règles", "rules"), ("/Rules/AllowedSenders", "Expéditeurs autorisés", "shield")]),
        ("Activité", [("/History", "Historique", "clock"), ("/Journal", "Journal", "list")]),
        ("Système", [("/Settings", "Paramètres", "sliders")]),
    };
    // The most specific matching entry is the active one (/Rules/AllowedSenders wins over /Rules).
    var activeUrl = groups.SelectMany(g => g.Items)
        .Where(i => i.Url == "/" ? path == "/" || path.Equals("/Index", StringComparison.OrdinalIgnoreCase)
                                 : path.Equals(i.Url, StringComparison.OrdinalIgnoreCase) || path.StartsWith(i.Url + "/", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(i => i.Url.Length).Select(i => i.Url).FirstOrDefault();
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mailflow</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Icons" />
    @if (authed)
    {
        <a class="skip-link visually-hidden-focusable" href="#main">Aller au contenu</a>
        <div class="app-shell">
            <nav class="sidenav" id="sidenav" aria-label="Navigation principale">
                <a class="wordmark" href="~/" aria-label="Mailflow, accueil"><svg class="icon" aria-hidden="true"><use href="#i-logo" /></svg>Mailflow</a>
                @foreach (var g in groups)
                {
                    <div class="nav-group">
                        <p class="nav-group-title">@g.Title</p>
                        <ul class="nav-list">
                            @foreach (var i in g.Items)
                            {
                                <li><a class="nav-link-item" href="~@i.Url" aria-current="@(i.Url == activeUrl ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-@i.Icon" /></svg>@i.Label</a></li>
                            }
                        </ul>
                    </div>
                }
            </nav>
            <div class="nav-scrim"></div>
            <div class="main-col">
                <header class="topbar">
                    <button type="button" class="btn btn-ghost btn-icon" data-nav-toggle aria-controls="sidenav" aria-expanded="false" aria-label="Afficher le menu"><svg class="icon" aria-hidden="true"><use href="#i-menu" /></svg></button>
                    <a class="wordmark" href="~/" aria-label="Mailflow, accueil"><svg class="icon" aria-hidden="true"><use href="#i-logo" /></svg>Mailflow</a>
                    <span class="topbar-spacer"></span>
                    <partial name="_WorkerPill" model="Worker" />
                    <button type="button" class="btn btn-ghost btn-icon theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Mode sombre" title="Mode sombre">
                        <svg class="icon icon-moon" aria-hidden="true"><use href="#i-moon" /></svg><svg class="icon icon-sun" aria-hidden="true"><use href="#i-sun" /></svg>
                    </button>
                    <form method="post" asp-page="/Logout" class="m-0">
                        <button type="submit" class="btn btn-secondary btn-sm"><svg class="icon" aria-hidden="true"><use href="#i-logout" /></svg>Déconnexion</button>
                    </form>
                </header>
                <main id="main" class="page" tabindex="-1">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="auth-shell">
            <main class="auth-card">
                <div class="wordmark"><svg class="icon" aria-hidden="true"><use href="#i-logo" /></svg>Mailflow</div>
                @RenderBody()
            </main>
        </div>
    }
    <div id="toasts" class="toast-region" role="status" aria-live="polite"></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
