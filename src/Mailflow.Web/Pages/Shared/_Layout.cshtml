@inject Mailflow.Web.Worker.WorkerState Worker
@inject Mailflow.Web.Updates.UpdateChecker Updates
@{
    var authed = User.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value ?? "/";
    var otherLang = IsEnglish ? "fr" : "en";
    var langLink = "/language/" + otherLang + "?returnUrl=" + Uri.EscapeDataString(path + Context.Request.QueryString);
    var groups = new (string Title, (string Url, string Label, string Icon)[] Items)[]
    {
        (T("Tableau de bord"), [("/", T("Accueil"), "home")]),
        (T("Configuration"), [("/Mailboxes", T("Boîtes mail"), "inbox"), ("/Printers", T("Imprimantes"), "printer"),
            ("/Categories", T("Catégories"), "tag"), ("/Rules", T("Règles"), "rules")]),
        (T("Activité"), [("/History", T("Historique"), "clock"), ("/Journal", T("Journal"), "list")]),
        (T("Système"), [("/Settings", T("Paramètres"), "sliders"), ("/Help", T("Aide"), "help")]),
    };
    // The most specific matching entry is the active one (longest URL wins).
    var activeUrl = groups.SelectMany(g => g.Items)
        .Where(i => i.Url == "/" ? path == "/" || path.Equals("/Index", StringComparison.OrdinalIgnoreCase)
                                 : path.Equals(i.Url, StringComparison.OrdinalIgnoreCase) || path.StartsWith(i.Url + "/", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(i => i.Url.Length).Select(i => i.Url).FirstOrDefault();
}
<!DOCTYPE html>
<html lang="@(IsEnglish ? "en" : "fr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mailflow</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Icons" />
    @if (authed)
    {
        <a class="skip-link visually-hidden-focusable" href="#main">@T("Aller au contenu")</a>
        <div class="app-shell">
            <nav class="sidenav" id="sidenav" aria-label="@T("Navigation principale")">
                <a class="wordmark" href="~/" aria-label="@T("Mailflow, accueil")"><svg class="icon" aria-hidden="true"><use href="#i-logo" /></svg>Mailflow</a>
                @foreach (var g in groups)
                {
                    <div class="nav-group">
                        <p class="nav-group-title">@g.Title</p>
                        <ul class="nav-list">
                            @foreach (var i in g.Items)
                            {
                                <li><a class="nav-link-item" href="@Url.Content("~" + i.Url)" aria-current="@(i.Url == activeUrl ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-@i.Icon" /></svg>@i.Label</a></li>
                            }
                        </ul>
                    </div>
                }
            </nav>
            <div class="nav-scrim"></div>
            <div class="main-col">
                <header class="topbar">
                    <button type="button" class="btn btn-ghost btn-icon" data-nav-toggle aria-controls="sidenav" aria-expanded="false" aria-label="@T("Afficher le menu")"><svg class="icon" aria-hidden="true"><use href="#i-menu" /></svg></button>
                    <a class="wordmark" href="~/" aria-label="@T("Mailflow, accueil")"><svg class="icon" aria-hidden="true"><use href="#i-logo" /></svg>Mailflow</a>
                    <span class="topbar-spacer"></span>
                    <partial name="_WorkerPill" model="Worker" />
                    <button type="button" class="btn btn-ghost btn-icon theme-toggle" data-theme-toggle aria-pressed="false" aria-label="@T("Mode sombre")" title="@T("Mode sombre")">
                        <svg class="icon icon-moon" aria-hidden="true"><use href="#i-moon" /></svg><svg class="icon icon-sun" aria-hidden="true"><use href="#i-sun" /></svg>
                    </button>
                    <a class="btn btn-ghost btn-sm" href="@Url.Content("~/Help")"><svg class="icon" aria-hidden="true"><use href="#i-help" /></svg>@T("Aide")</a>
                    <a class="btn btn-ghost btn-sm" href="@Url.Content("~" + langLink)" hreflang="@otherLang" lang="@otherLang" title="@(IsEnglish ? "Français" : "English")">@otherLang.ToUpperInvariant()</a>
                    <form method="post" asp-page="/Logout" class="m-0">
                        <button type="submit" class="btn btn-secondary btn-sm"><svg class="icon" aria-hidden="true"><use href="#i-logout" /></svg>@T("Déconnexion")</button>
                    </form>
                </header>
                @if (Updates.Available is { } update)
                {
                    <div class="alert alert-info alert-dismissible m-3 mb-0" role="status" data-update-banner="@update.Tag">
                        @T("Une nouvelle version de Mailflow est disponible ({0}).", update.Tag)
                        <a class="alert-link" href="@update.Url" target="_blank" rel="noopener noreferrer">@T("Voir la version")</a>
                        @if (Updates.InstallEnabled && Mailflow.Web.Updates.UpdateInstaller.IsSetupInstall())
                        {
                            <form method="post" asp-page="/Update" class="d-inline ms-2">
                                <button type="submit" class="btn btn-sm btn-primary">@T("Mettre à jour maintenant")</button>
                            </form>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T("Fermer")"></button>
                    </div>
                }
                @if (Updates.FailedTag is { } failedTag)
                {
                    <div class="alert alert-warning alert-dismissible m-3 mb-0" role="alert" data-update-failed="@failedTag">
                        @T("La mise à jour vers {0} n'a pas abouti. Mailflow continue avec la version actuelle.", failedTag)
                        <a class="alert-link" href="https://github.com/ArmSal/mailflow/releases/tag/@failedTag" target="_blank" rel="noopener noreferrer">@T("Installer à la main")</a>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T("Fermer")"></button>
                    </div>
                }
                <main id="main" class="page" tabindex="-1">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="auth-shell">
            <main class="auth-card">
                <div class="wordmark"><svg class="icon" aria-hidden="true"><use href="#i-logo" /></svg>Mailflow</div>
                <a class="btn btn-ghost btn-sm" href="@Url.Content("~" + langLink)" hreflang="@otherLang" lang="@otherLang">@(IsEnglish ? "Français" : "English")</a>
                @RenderBody()
            </main>
        </div>
    }
    <div id="toasts" class="toast-region" role="status" aria-live="polite"></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
