@model Mailflow.Web.Pages.IndexModel
@{
    string Fmt(DateTime? utc) => utc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-";
    var target = "#status";
}
<div id="status" hx-get="@Url.Page("/Index", "Status")" hx-trigger="every 10s" hx-swap="outerHTML">
    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap gap-3 align-items-center">
            <span class="badge fs-6 @Model.StatusClass">@Model.StatusLabel</span>
            <span>Dernière relève : @Fmt(Model.State.LastRunUtc)</span>
            <span>Prochaine relève : @Fmt(Model.State.NextRunUtc)</span>
            <div class="ms-auto d-flex gap-2">
                <form method="post" hx-post="@Url.Page("/Index", "RunNow")" hx-target="@target" hx-swap="outerHTML">
                    <button class="btn btn-primary btn-sm" type="submit">Lancer maintenant</button>
                </form>
                @if (Model.State.IsPaused)
                {
                    <form method="post" hx-post="@Url.Page("/Index", "Resume")" hx-target="@target" hx-swap="outerHTML">
                        <button class="btn btn-success btn-sm" type="submit">Reprendre</button>
                    </form>
                }
                else
                {
                    <form method="post" hx-post="@Url.Page("/Index", "Pause")" hx-target="@target" hx-swap="outerHTML">
                        <button class="btn btn-outline-warning btn-sm" type="submit">Pause</button>
                    </form>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.State.LastError))
        {
            <div class="card-footer text-danger small">@Model.State.LastError</div>
        }
    </div>

    <h2 class="h5">Aujourd'hui</h2>
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Messages traités</div><div class="fs-4">@Model.Today.Messages</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Documents enregistrés</div><div class="fs-4">@Model.Today.Documents</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Imprimés</div><div class="fs-4">@Model.Today.Printed</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Erreurs</div><div class="fs-4 @(Model.Today.Errors > 0 ? "text-danger" : "")">@Model.Today.Errors</div></div></div></div>
    </div>

    <h2 class="h5">Dernières erreurs</h2>
    @if (Model.MailboxErrors.Count == 0 && Model.RunErrors.Count == 0)
    {
        <p class="text-muted">Aucune erreur.</p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (var e in Model.MailboxErrors)
            {
                <li class="list-group-item"><strong>@e.Name</strong> <span class="text-muted small">@Fmt(e.At)</span><div class="text-danger small">@e.Error</div></li>
            }
            @foreach (var e in Model.RunErrors)
            {
                <li class="list-group-item"><strong>@e.Mailbox</strong> <span class="text-muted small">@Fmt(e.At)</span><div class="text-danger small">@e.Error</div></li>
            }
        </ul>
    }

    <h2 class="h5">Derniers documents</h2>
    <table class="table table-sm align-middle">
        <thead><tr><th>Nom</th><th>Catégorie</th><th>Impression</th></tr></thead>
        <tbody>
        @foreach (var d in Model.Documents)
        {
            <tr>
                <td>@d.Name</td>
                <td>@d.Category</td>
                <td>
                    @if (d.PrintError != null) { <span class="text-danger">Erreur : @d.PrintError</span> }
                    else if (d.PrintedAt != null) { <span class="text-success">Imprimé @Fmt(d.PrintedAt)</span> }
                    else { <span class="text-muted">Non imprimé</span> }
                </td>
            </tr>
        }
        @if (Model.Documents.Count == 0) { <tr><td colspan="3" class="text-muted">Aucun document.</td></tr> }
        </tbody>
    </table>
</div>
