@model Mailflow.Web.Pages.IndexModel
@{
    string Fmt(DateTime? utc) => utc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-";
    var target = "#status";
    var state = Model.State.IsPaused ? "paused" : Model.State.IsRunning ? "running" : "idle";
    var icon = state == "paused" ? "pause" : state == "running" ? "refresh" : "check";
}
<div id="status" class="stack" hx-get="@Url.Page("/Index", "Status")" hx-trigger="every 10s" hx-swap="outerHTML">
    @if (Context.Request.Headers.ContainsKey("HX-Request"))
    {
        <partial name="_WorkerPill" model="Model.State" view-data='new ViewDataDictionary(ViewData) { ["Oob"] = true }' />
    }

    <section class="card status-panel" data-state="@state" aria-label="État du traitement">
        <div class="status-panel-main">
            <span class="status-orb"><svg class="icon" aria-hidden="true"><use href="#i-@icon" /></svg></span>
            <div>
                <div class="status-panel-title">@Model.StatusLabel</div>
                <div class="status-panel-meta">
                    <span>Dernière relève : @Fmt(Model.State.LastRunUtc)</span>
                    <span>Prochaine relève : @Fmt(Model.State.NextRunUtc)</span>
                </div>
            </div>
        </div>
        <div class="status-panel-actions">
            <form method="post" hx-post="@Url.Page("/Index", "RunNow")" hx-target="@target" hx-swap="outerHTML">
                <button class="btn btn-primary" type="submit"><svg class="icon" aria-hidden="true"><use href="#i-play" /></svg>Lancer maintenant</button>
            </form>
            @if (Model.State.IsPaused)
            {
                <form method="post" hx-post="@Url.Page("/Index", "Resume")" hx-target="@target" hx-swap="outerHTML">
                    <button class="btn btn-secondary" type="submit"><svg class="icon" aria-hidden="true"><use href="#i-play" /></svg>Reprendre</button>
                </form>
            }
            else
            {
                <form method="post" hx-post="@Url.Page("/Index", "Pause")" hx-target="@target" hx-swap="outerHTML">
                    <button class="btn btn-secondary" type="submit"><svg class="icon" aria-hidden="true"><use href="#i-pause" /></svg>Pause</button>
                </form>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.State.LastError))
        {
            <p class="status-panel-error">@Model.State.LastError</p>
        }
    </section>

    <section aria-labelledby="today-title">
        <h2 id="today-title" class="section-title">Aujourd'hui</h2>
        <div class="stat-grid">
            <div class="stat"><div><div class="stat-label">Messages traités</div><div class="stat-value">@Model.Today.Messages</div></div><span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-inbox" /></svg></span></div>
            <div class="stat"><div><div class="stat-label">Documents enregistrés</div><div class="stat-value">@Model.Today.Documents</div></div><span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-file" /></svg></span></div>
            <div class="stat"><div><div class="stat-label">Imprimés</div><div class="stat-value">@Model.Today.Printed</div></div><span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-printer" /></svg></span></div>
            <div class="stat @(Model.Today.Errors > 0 ? "stat--error" : "")"><div><div class="stat-label">Erreurs</div><div class="stat-value">@Model.Today.Errors</div></div><span class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg></span></div>
        </div>
    </section>

    <div class="split">
        <section aria-labelledby="docs-title">
            <h2 id="docs-title" class="section-title">Derniers documents</h2>
            @if (Model.Documents.Count == 0)
            {
                <div class="card">
                    <div class="empty-state">
                        <span class="empty-state-icon"><svg class="icon" aria-hidden="true"><use href="#i-file" /></svg></span>
                        <h3 class="empty-state-title">Aucun document pour le moment</h3>
                        <p>Les pièces jointes PDF apparaissent ici dès qu'une boîte mail a été relevée.</p>
                        <a class="btn btn-primary" href="~/Mailboxes">Configurer une boîte mail</a>
                    </div>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table align-middle">
                        <thead><tr><th scope="col">Nom</th><th scope="col">Catégorie</th><th scope="col">Impression</th></tr></thead>
                        <tbody>
                        @foreach (var d in Model.Documents)
                        {
                            <tr>
                                <td class="cell-clip" title="@d.Name">@d.Name</td>
                                <td>@d.Category</td>
                                <td>
                                    @if (d.PrintError != null) { <span class="badge badge-error">Erreur</span><span class="cell-sub">@d.PrintError</span> }
                                    else if (d.PrintedAt != null) { <span class="badge badge-ok">Imprimé</span><span class="cell-sub">@Fmt(d.PrintedAt)</span> }
                                    else { <span class="badge badge-neutral">Non imprimé</span> }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section aria-labelledby="errors-title">
            <h2 id="errors-title" class="section-title">Dernières erreurs</h2>
            <div class="card">
                @if (Model.MailboxErrors.Count == 0 && Model.RunErrors.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-state-icon"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg></span>
                        <h3 class="empty-state-title">Aucune erreur</h3>
                        <p>Tout fonctionne normalement.</p>
                    </div>
                }
                else
                {
                    <ul class="event-list">
                        @foreach (var e in Model.MailboxErrors)
                        {
                            <li><svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg><div><div><span class="event-title">@e.Name</span> <span class="event-meta">@Fmt(e.At)</span></div><div class="event-text">@e.Error</div></div></li>
                        }
                        @foreach (var e in Model.RunErrors)
                        {
                            <li><svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg><div><div><span class="event-title">@e.Mailbox</span> <span class="event-meta">@Fmt(e.At)</span></div><div class="event-text">@e.Error</div></div></li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
</div>
