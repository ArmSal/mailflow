@page
@using Mailflow.Domain.Entities
@model Mailflow.Web.Pages.Stores.IndexModel
@{ ViewData["Title"] = "Magasins"; }
<link rel="stylesheet" href="~/css/page-config.css" asp-append-version="true" />
<div class="page-header">
    <div>
        <h1 class="page-title">Magasins</h1>
        <p class="page-subtitle">Les points de vente qui reçoivent des documents.</p>
    </div>
    <div class="page-actions"><a class="btn btn-primary" asp-page="Edit"><svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>Ajouter un magasin</a></div>
</div>
@if (!Model.Items.Any())
{
    <div class="card"><div class="empty-state">
        <span class="empty-state-icon"><svg class="icon" aria-hidden="true"><use href="#i-store" /></svg></span>
        <h2 class="empty-state-title">Aucun magasin</h2>
        <p>Ajoutez votre premier magasin pour y rattacher des boîtes mail et des imprimantes.</p>
        <a class="btn btn-primary" asp-page="Edit">Ajouter un magasin</a>
    </div></div>
}
else
{
<div class="table-wrap">
    <table class="table align-middle">
        <thead><tr><th scope="col">Nom</th><th scope="col">Adresse</th><th scope="col">Statut</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
        @foreach (var s in Model.Items)
        {
            <partial name="_StoreRow" model="s" />
        }
        </tbody>
    </table>
</div>
}

