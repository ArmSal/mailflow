@model Mailflow.Domain.Entities.Store
<tr>
    <td><strong>@Model.Name</strong>
        @if (ViewData["Error"] is string err) { <span class="cell-inline-error" role="alert">@err</span> }
    </td>
    <td>@Model.Address</td>
    <td>
        <form method="post" hx-post="@Url.Page("/Stores/Index", "Toggle", new { id = Model.Id })" hx-target="closest tr" hx-swap="outerHTML">
            <button class="badge-toggle @(Model.IsActive ? "badge-ok" : "badge-neutral")" type="submit" title="@(Model.IsActive ? "Cliquer pour désactiver" : "Cliquer pour activer")">@(Model.IsActive ? "Actif" : "Inactif")</button>
        </form>
    </td>
    <td>
        <div class="row-actions row-actions-nowrap">
            <a class="btn btn-sm btn-secondary" asp-page="/Stores/Edit" asp-route-id="@Model.Id">Modifier</a>
            <form method="post" hx-post="@Url.Page("/Stores/Index", "Delete", new { id = Model.Id })" hx-target="closest tr" hx-swap="outerHTML" hx-confirm="Supprimer ce magasin ?">
                <button class="btn btn-sm btn-danger" type="submit">Supprimer</button>
            </form>
        </div>
    </td>
</tr>
