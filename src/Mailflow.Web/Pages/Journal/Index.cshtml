@page
@model Mailflow.Web.Pages.Journal.IndexModel
@{ ViewData["Title"] = "Journal"; }
<div class="page-header">
    <div>
        <h1 class="page-title">Journal</h1>
        <p class="page-subtitle">Chaque relève de boîte mail, avec sa durée et son résultat.</p>
    </div>
</div>
<form method="get" class="toolbar" role="search" aria-label="Filtrer le journal">
    <div class="field">
        <label class="form-label" for="MailboxId">Boîte mail</label>
        <select class="form-select" id="MailboxId" name="MailboxId">
            <option value="">Toutes</option>
            @foreach (var m in Model.Mailboxes)
            {
                <option value="@m.Id" selected="@(Model.MailboxId == m.Id)">@m.DisplayName</option>
            }
        </select>
    </div>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="ErrorsOnly" name="ErrorsOnly" value="true" checked="@Model.ErrorsOnly" />
        <label class="form-check-label" for="ErrorsOnly">Erreurs seulement</label>
    </div>
    <div class="toolbar-end"><button class="btn btn-primary" type="submit">Filtrer</button></div>
</form>
@if (Model.Rows.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state-icon"><svg class="icon" aria-hidden="true"><use href="#i-list" /></svg></span>
            <h2 class="empty-state-title">Aucune entrée</h2>
            <p>Aucune relève ne correspond à ces filtres.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table align-middle">
            <thead><tr><th scope="col">Date</th><th scope="col">Boîte mail</th><th scope="col" class="num">Durée</th><th scope="col" class="num">Messages</th><th scope="col" class="num">Documents</th><th scope="col" class="num">Imprimés</th><th scope="col">Résultat</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td class="text-nowrap">@r.Log.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td class="text-nowrap">@r.Mailbox</td>
                    <td class="num text-nowrap">@Mailflow.Web.Pages.Journal.IndexModel.FormatDuration(r.Log.Duration)</td>
                    <td class="num">@r.Log.MessagesHandled</td>
                    <td class="num">@r.Log.DocumentsSaved</td>
                    <td class="num">@r.Log.Printed</td>
                    <td class="cell-result">
                        @if (string.IsNullOrEmpty(r.Log.Error)) { <span class="badge badge-ok">OK</span> }
                        else { <span class="badge badge-error">Erreur</span><span class="cell-sub">@r.Log.Error</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-ErrorsOnly="@Model.ErrorsOnly" asp-route-MailboxId="@Model.MailboxId">Précédent</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.PageNumber / @Model.TotalPages</span></li>
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-ErrorsOnly="@Model.ErrorsOnly" asp-route-MailboxId="@Model.MailboxId">Suivant</a>
            </li>
        </ul>
    </nav>
}
