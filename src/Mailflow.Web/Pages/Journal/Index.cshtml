@page
@model Mailflow.Web.Pages.Journal.IndexModel
@{ ViewData["Title"] = T("Journal"); }
<div class="page-header">
    <div>
        <h1 class="page-title">@T("Journal")</h1>
        <p class="page-subtitle">@T("Chaque relève de boîte mail, avec sa durée et son résultat.")</p>
    </div>
</div>
<form method="get" class="toolbar" role="search" aria-label="@T("Filtrer le journal")">
    <div class="field">
        <label class="form-label" for="MailboxId">@T("Boîte mail")</label>
        <select class="form-select" id="MailboxId" name="MailboxId">
            <option value="">@T("Toutes")</option>
            @foreach (var m in Model.Mailboxes)
            {
                <option value="@m.Id" selected="@(Model.MailboxId == m.Id)">@m.DisplayName</option>
            }
        </select>
    </div>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="ErrorsOnly" name="ErrorsOnly" value="true" checked="@Model.ErrorsOnly" />
        <label class="form-check-label" for="ErrorsOnly">@T("Erreurs seulement")</label>
    </div>
    <div class="toolbar-end"><button class="btn btn-primary" type="submit">@T("Filtrer")</button></div>
</form>
@if (Model.Rows.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state-icon"><svg class="icon" aria-hidden="true"><use href="#i-list" /></svg></span>
            <h2 class="empty-state-title">@T("Aucune entrée")</h2>
            <p>@T("Aucune relève ne correspond à ces filtres.")</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table align-middle">
            <thead><tr><th scope="col">@T("Date")</th><th scope="col">@T("Boîte mail")</th><th scope="col" class="num">@T("Durée")</th><th scope="col" class="num">@T("Messages")</th><th scope="col" class="num">@T("Documents")</th><th scope="col" class="num">@T("Imprimés")</th><th scope="col">@T("Résultat")</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td class="text-nowrap">@r.Log.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td class="text-nowrap">@r.Mailbox</td>
                    <td class="num text-nowrap">@Mailflow.Web.Pages.Journal.IndexModel.FormatDuration(r.Log.Duration)</td>
                    <td class="num">@r.Log.MessagesHandled</td>
                    <td class="num">@r.Log.DocumentsSaved</td>
                    <td class="num">@r.Log.Printed</td>
                    <td class="cell-result">
                        @if (string.IsNullOrEmpty(r.Log.Error)) { <span class="badge badge-ok">OK</span> }
                        else { <span class="badge badge-error">@T("Erreur")</span><span class="cell-sub">@T(r.Log.Error)</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="@T("Pagination")">
        <ul class="pagination">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-ErrorsOnly="@Model.ErrorsOnly" asp-route-MailboxId="@Model.MailboxId">@T("Précédent")</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@T("Page {0} / {1}", Model.PageNumber, Model.TotalPages)</span></li>
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-ErrorsOnly="@Model.ErrorsOnly" asp-route-MailboxId="@Model.MailboxId">@T("Suivant")</a>
            </li>
        </ul>
    </nav>
}
