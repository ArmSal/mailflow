@page
@model Mailflow.Web.Pages.History.IndexModel
@{ ViewData["Title"] = "Historique"; }
<link rel="stylesheet" href="~/css/page-activity.css" asp-append-version="true" />
<div class="page-header">
    <div>
        <h1 class="page-title">Historique</h1>
        <p class="page-subtitle">Les documents reçus : ouvrez le PDF, réimprimez-le ou changez sa catégorie.</p>
    </div>
</div>
<form method="get" class="toolbar" role="search" aria-label="Filtrer l'historique">
    <div class="field field-sm">
        <label class="form-label" asp-for="From">Du</label>
        <input class="form-control" type="date" asp-for="From" />
    </div>
    <div class="field field-sm">
        <label class="form-label" asp-for="To">Au</label>
        <input class="form-control" type="date" asp-for="To" />
    </div>
    <div class="field field-md">
        <label class="form-label" asp-for="Supplier">Fournisseur</label>
        <input class="form-control" asp-for="Supplier" maxlength="200" placeholder="domaine ou adresse" />
    </div>
    <div class="field field-md">
        <label class="form-label" asp-for="CategoryId">Catégorie</label>
        <select class="form-select" asp-for="CategoryId">
            <option value="">Toutes</option>
            @foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option> }
        </select>
    </div>
    <div class="field field-md">
        <label class="form-label" asp-for="StoreId">Magasin</label>
        <select class="form-select" asp-for="StoreId">
            <option value="">Tous</option>
            @foreach (var s in Model.Stores) { <option value="@s.Id" selected="@(s.Id == Model.StoreId)">@s.Name</option> }
        </select>
    </div>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" asp-for="ErrorsOnly" value="true" />
        <label class="form-check-label" asp-for="ErrorsOnly">Erreurs d'impression seulement</label>
    </div>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" asp-for="UnverifiedOnly" value="true" />
        <label class="form-check-label" asp-for="UnverifiedOnly">Expéditeurs non vérifiés seulement</label>
    </div>
    <div class="toolbar-end"><button class="btn btn-primary" type="submit">Rechercher</button></div>
</form>
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert"><span asp-validation-for="To"></span></div>
}

<p class="result-count" role="status">@Model.Result.Total document(s)</p>
@if (Model.Result.Items.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state-icon"><svg class="icon" aria-hidden="true"><use href="#i-inbox" /></svg></span>
            <h2 class="empty-state-title">Aucun document</h2>
            <p>Aucun document ne correspond à ces filtres.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap table-wrap--menu">
        <table class="table align-middle">
            <thead><tr><th scope="col">Reçu le</th><th scope="col">Document</th><th scope="col">Catégorie</th><th scope="col">Magasin</th><th scope="col">Impression</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
            @foreach (var row in Model.Result.Items)
            {
                <partial name="_Row" model="new Mailflow.Web.Pages.History.HistoryRowModel(row, Model.Printers, Model.Categories, null, true)" />
            }
            </tbody>
        </table>
    </div>
}

@if (Model.Result.PageCount > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination">
            @for (var i = 1; i <= Model.Result.PageCount; i++)
            {
                <li class="page-item @(i == Model.Result.Page ? "active" : "")">
                    <a class="page-link" asp-page="Index" asp-route-From="@Model.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.To?.ToString("yyyy-MM-dd")"
                       asp-route-Supplier="@Model.Supplier" asp-route-CategoryId="@Model.CategoryId" asp-route-StoreId="@Model.StoreId"
                       asp-route-ErrorsOnly="@(Model.ErrorsOnly ? "true" : null)" asp-route-UnverifiedOnly="@(Model.UnverifiedOnly ? "true" : null)" asp-route-PageNumber="@i" aria-current="@(i == Model.Result.Page ? "page" : null)">@i</a>
                </li>
            }
        </ul>
    </nav>
}

