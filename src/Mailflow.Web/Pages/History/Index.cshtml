@page
@model Mailflow.Web.Pages.History.IndexModel
@{ ViewData["Title"] = "Historique"; }
<h1 class="h3 mb-3">Historique</h1>
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-2">
        <label class="form-label" asp-for="From">Du</label>
        <input class="form-control" type="date" asp-for="From" />
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="To">Au</label>
        <input class="form-control" type="date" asp-for="To" />
        <span class="text-danger small" asp-validation-for="To"></span>
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="Supplier">Fournisseur</label>
        <input class="form-control" asp-for="Supplier" maxlength="200" placeholder="domaine ou adresse" />
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="CategoryId">Catégorie</label>
        <select class="form-select" asp-for="CategoryId">
            <option value="">Toutes</option>
            @foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option> }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label" asp-for="StoreId">Magasin</label>
        <select class="form-select" asp-for="StoreId">
            <option value="">Tous</option>
            @foreach (var s in Model.Stores) { <option value="@s.Id" selected="@(s.Id == Model.StoreId)">@s.Name</option> }
        </select>
    </div>
    <div class="col-md-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="ErrorsOnly" value="true" />
            <label class="form-check-label" asp-for="ErrorsOnly">Erreurs d'impression seulement</label>
        </div>
        <button class="btn btn-primary btn-sm mt-1" type="submit">Rechercher</button>
    </div>
</form>

<p class="text-muted">@Model.Result.Total document(s)</p>
<table class="table align-middle">
    <thead><tr><th>Reçu le</th><th>Expéditeur</th><th>Objet</th><th>Fichier</th><th>Catégorie</th><th>Magasin</th><th>Impression</th><th></th></tr></thead>
    <tbody>
    @foreach (var row in Model.Result.Items)
    {
        <partial name="_Row" model="new Mailflow.Web.Pages.History.HistoryRowModel(row, Model.Printers, Model.Categories, null, true)" />
    }
    @if (Model.Result.Items.Count == 0)
    {
        <tr><td colspan="8" class="text-center text-muted">Aucun document.</td></tr>
    }
    </tbody>
</table>

@if (Model.Result.PageCount > 1)
{
    <nav aria-label="Pages">
        <ul class="pagination">
            @for (var i = 1; i <= Model.Result.PageCount; i++)
            {
                <li class="page-item @(i == Model.Result.Page ? "active" : "")">
                    <a class="page-link" asp-page="Index" asp-route-From="@Model.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.To?.ToString("yyyy-MM-dd")"
                       asp-route-Supplier="@Model.Supplier" asp-route-CategoryId="@Model.CategoryId" asp-route-StoreId="@Model.StoreId"
                       asp-route-ErrorsOnly="@(Model.ErrorsOnly ? "true" : null)" asp-route-PageNumber="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
