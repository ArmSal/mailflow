@page
@model Mailflow.Web.Pages.Settings.IndexModel
@{ ViewData["Title"] = "Paramètres"; }
<link rel="stylesheet" href="~/css/page-activity.css" asp-append-version="true" />
<div class="page-header">
    <div>
        <h1 class="page-title">Paramètres</h1>
        <p class="page-subtitle">Stockage des documents, impression, sécurité et sauvegarde.</p>
    </div>
</div>

<div class="settings-stack">
<form method="post" asp-page-handler="Settings">
    @if (Model.SettingsMessage is not null) { <div class="alert alert-success" role="status">@Model.SettingsMessage</div> }
    @if (ViewData.ModelState.Keys.Any(k => k.StartsWith("Input.") && ViewData.ModelState[k]!.Errors.Count > 0)) { <div class="alert alert-danger" role="alert">Certains paramètres sont invalides : corrigez les champs signalés puis enregistrez de nouveau.</div> }
    <section class="form-section">
        <h2 class="form-section-title">Dossier des documents</h2>
        <p class="form-section-hint">Où sont archivés les PDF reçus.</p>
        <div class="field">
            <label class="form-label" asp-for="Input.DocumentsRoot">Dossier des documents</label>
            <input class="form-control" asp-for="Input.DocumentsRoot" />
            <span class="field-validation-error" asp-validation-for="Input.DocumentsRoot"></span>
        </div>
    </section>
    <section class="form-section">
        <h2 class="form-section-title">Nom de fichier</h2>
        <p class="form-section-hint">Comment chaque document est nommé une fois archivé.</p>
        <div class="field">
            <label class="form-label" asp-for="Input.FileNamePattern">Modèle de nom de fichier</label>
            <input class="form-control" asp-for="Input.FileNamePattern" />
            <span class="form-text">Doit contenir <code>{OriginalName}</code>. Jetons : <code>{Category}</code>, <code>{Supplier}</code>, <code>{OriginalName}</code>, <code>{yyyy}</code>, <code>{MM}</code>, <code>{yyyy-MM-dd}</code>.</span>
            <span class="field-validation-error" asp-validation-for="Input.FileNamePattern"></span>
        </div>
    </section>
    <section class="form-section">
        <h2 class="form-section-title">Impression</h2>
        <p class="form-section-hint">Les documents plus anciens que cette durée ne sont pas imprimés automatiquement.</p>
        <div class="field">
            <label class="form-label" asp-for="Input.PrintMaxAgeHours">Âge maximum d'impression (heures, 1 à 168)</label>
            <input type="number" class="form-control" asp-for="Input.PrintMaxAgeHours" />
            <span class="field-validation-error" asp-validation-for="Input.PrintMaxAgeHours"></span>
        </div>
    </section>
    <div class="form-actions mb-4"><button class="btn btn-primary" type="submit">Enregistrer</button></div>
</form>

<form method="post" asp-page-handler="Microsoft">
    <section class="form-section">
        <h2 class="form-section-title">Connexion Microsoft</h2>
        <p class="form-section-hint">Pour relever une boîte Outlook / Hotmail sans mot de passe (OAuth2). Gratuit, aucun secret à conserver.</p>
        @if (Model.MicrosoftMessage is not null) { <div class="alert alert-success" role="status">@Model.MicrosoftMessage</div> }
        <p><span class="badge @(Model.MicrosoftConfigured ? "badge-ok" : "badge-neutral")">@(Model.MicrosoftConfigured ? "Configuré" : "Non configuré")</span></p>
        <div class="field">
            <label class="form-label" asp-for="Microsoft.ClientId">Identifiant d'application Azure (client)</label>
            <input class="form-control" asp-for="Microsoft.ClientId" autocomplete="off" spellcheck="false" placeholder="00000000-0000-0000-0000-000000000000" />
            <span class="form-text">Laisser vide pour désactiver. Procédure pas à pas : <code>Docs/microsoft-oauth-setup.md</code>.</span>
            <span class="field-validation-error" asp-validation-for="Microsoft.ClientId"></span>
        </div>
    </section>
    <div class="form-actions mb-4"><button class="btn btn-primary" type="submit">Enregistrer</button></div>
</form>

<form method="post" asp-page-handler="Password">
    <section class="form-section">
        <h2 class="form-section-title">Sécurité</h2>
        <p class="form-section-hint">Changer le mot de passe administrateur.</p>
        @if (Model.PasswordMessage is not null) { <div class="alert @(Model.PasswordOk ? "alert-success" : "alert-danger")" role="@(Model.PasswordOk ? "status" : "alert")">@Model.PasswordMessage</div> }
        <div class="field"><label class="form-label" asp-for="Password.Current">Mot de passe actuel</label><input class="form-control" asp-for="Password.Current" autocomplete="current-password" /></div>
        <div class="form-grid">
            <div class="field"><label class="form-label" asp-for="Password.New">Nouveau mot de passe (8 caractères minimum)</label><input class="form-control" asp-for="Password.New" autocomplete="new-password" /></div>
            <div class="field"><label class="form-label" asp-for="Password.Confirm">Confirmer le nouveau mot de passe</label><input class="form-control" asp-for="Password.Confirm" autocomplete="new-password" /></div>
        </div>
    </section>
    <div class="form-actions mb-4"><button class="btn btn-primary" type="submit">Changer le mot de passe</button></div>
</form>

<section class="form-section">
    <h2 class="form-section-title">Sauvegarde</h2>
    <p class="form-section-hint">Une sauvegarde de la base est créée chaque nuit à 02:00 dans le dossier « backups » des documents (14 conservées).</p>
    <div id="backup-result" aria-live="polite"></div>
    <form method="post" asp-page-handler="Backup" hx-post="@Url.Page("/Settings/Index", "Backup")" hx-target="#backup-result" hx-swap="innerHTML" class="mb-3">
        <button class="btn btn-secondary" type="submit">Sauvegarder maintenant</button>
    </form>
</section>
</div>
