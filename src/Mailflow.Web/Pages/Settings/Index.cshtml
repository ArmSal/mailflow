@page
@model Mailflow.Web.Pages.Settings.IndexModel
@{ ViewData["Title"] = T("Paramètres"); }
<link rel="stylesheet" href="~/css/page-activity.css" asp-append-version="true" />
<div class="page-header">
    <div>
        <h1 class="page-title">@T("Paramètres")</h1>
        <p class="page-subtitle">@T("Stockage des documents, impression, sécurité et sauvegarde.")</p>
    </div>
</div>

<div class="settings-stack">
<form method="post" asp-page-handler="Settings">
    @if (Model.SettingsMessage is not null) { <div class="alert alert-success" role="status">@Model.SettingsMessage</div> }
    @if (ViewData.ModelState.Keys.Any(k => k.StartsWith("Input.") && ViewData.ModelState[k]!.Errors.Count > 0)) { <div class="alert alert-danger" role="alert">@T("Certains paramètres sont invalides : corrigez les champs signalés puis enregistrez de nouveau.")</div> }
    <section class="form-section">
        <h2 class="form-section-title">@T("Dossier des documents")</h2>
        <p class="form-section-hint">@T("Où sont archivés les PDF reçus.")</p>
        <div class="field">
            <label class="form-label" asp-for="Input.DocumentsRoot">@T("Dossier des documents")</label>
            <div class="d-flex gap-2">
                <input class="form-control" asp-for="Input.DocumentsRoot" />
                <button type="button" class="btn btn-secondary text-nowrap" id="browse-folder">@T("Parcourir…")</button>
            </div>
            <div id="folder-browser"></div>
            <span class="field-validation-error" asp-validation-for="Input.DocumentsRoot"></span>
        </div>
    </section>
    <section class="form-section">
        <h2 class="form-section-title">@T("Nom de fichier")</h2>
        <p class="form-section-hint">@T("Comment chaque document est nommé une fois archivé.")</p>
        <div class="field">
            <label class="form-label" asp-for="Input.FileNamePattern">@T("Modèle de nom de fichier")</label>
            <input class="form-control" asp-for="Input.FileNamePattern" />
            <span class="form-text">@T("Doit contenir") <code>{OriginalName}</code>. @T("Jetons :") <code>{Category}</code>, <code>{Supplier}</code>, <code>{OriginalName}</code>, <code>{yyyy}</code>, <code>{MM}</code>, <code>{dd}</code>, <code>{yyyy-MM-dd}</code>, <code>{dd-MM-yyyy}</code>.</span>
            <span class="field-validation-error" asp-validation-for="Input.FileNamePattern"></span>
        </div>
    </section>
    <section class="form-section">
        <h2 class="form-section-title">@T("Impression")</h2>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" asp-for="Input.PrintEmailBodyWithoutPdf" />
            <label class="form-check-label" asp-for="Input.PrintEmailBodyWithoutPdf">@T("Imprimer le contenu de l'e-mail lorsqu'aucun PDF n'est joint")</label>
            <div class="form-text">@T("Si une règle d'impression correspond à un e-mail sans pièce jointe PDF, Mailflow génère un PDF avec son texte et l'envoie à l'imprimante.")</div>
        </div>
    </section>
    <section class="form-section">
        <h2 class="form-section-title">@T("Notifications")</h2>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" asp-for="Input.ToastNotifications" />
            <label class="form-check-label" asp-for="Input.ToastNotifications">@T("Afficher une notification Windows après un échec définitif")</label>
            <div class="form-text">@T("Connexion à une boîte mail impossible ou impression en échec, après plusieurs tentatives. L'échec reste visible dans l'Historique. Disponible dans l'application de bureau.")</div>
        </div>
    </section>
    <section class="form-section">
        <h2 class="form-section-title">@T("Mises à jour")</h2>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" asp-for="Input.UpdateCheck" />
            <label class="form-check-label" asp-for="Input.UpdateCheck">@T("Vérifier les nouvelles versions")</label>
            <div class="form-text">@T("Une fois par jour, Mailflow demande à GitHub si une version plus récente existe et l'indique par un bandeau. Aucune donnée personnelle n'est envoyée ; rien n'est installé sans que vous l'ayez activé ci-dessous.")</div>
        </div>
        <div class="field mt-3">
            <label class="form-label" asp-for="Input.UpdateMode">@T("Installation des mises à jour")</label>
            <select class="form-select" asp-for="Input.UpdateMode">
                <option value="Notify">@T("M'avertir seulement (bandeau)")</option>
                <option value="Manual">@T("Proposer « Mettre à jour maintenant » dans le bandeau")</option>
                <option value="Auto">@T("Installer automatiquement quand Mailflow est inactif")</option>
            </select>
            <div class="form-text">@T("L'installation télécharge la nouvelle version, vérifie sa signature, sauvegarde la base de données puis l'installe en conservant vos données, et relance Mailflow en arrière-plan. Seules les versions signées par l'auteur sont acceptées. Disponible pour les installations faites avec l'installateur. En mode automatique, rien n'est installé pendant un relevé de boîtes ou une impression, et une version qui a échoué n'est pas réessayée.")</div>
        </div>
    </section>
    <div class="form-actions mb-4"><button class="btn btn-primary" type="submit">@T("Enregistrer")</button></div>
</form>

<form method="post" asp-page-handler="SenderCheck">
    <section class="form-section">
        <h2 class="form-section-title">@T("Vérification de l'expéditeur avant impression")</h2>
        <p class="form-section-hint">@T("L'adresse d'expédition d'un e-mail peut être falsifiée. Cette vérification s'appuie sur le verdict DKIM/DMARC du serveur de messagerie qui a reçu le message.")</p>
        @if (Model.SenderCheckMessage is not null) { <div class="alert alert-success" role="status">@Model.SenderCheckMessage</div> }
        @if (ViewData.ModelState.Keys.Any(k => k.StartsWith("SenderCheck.") && ViewData.ModelState[k]!.Errors.Count > 0)) { <div class="alert alert-danger" role="alert">@ViewData.ModelState["SenderCheck.Mode"]!.Errors[0].ErrorMessage</div> }
        <div class="field">
            <label class="form-label" asp-for="SenderCheck.Mode">@T("Mode de vérification")</label>
            <select class="form-select" asp-for="SenderCheck.Mode" aria-describedby="sender-check-help">
                <option value="Off" selected="@(Model.SenderCheck.Mode == "Off")">@T("Désactivée")</option>
                <option value="Warn" selected="@(Model.SenderCheck.Mode == "Warn")">@T("Avertir (recommandé)")</option>
                <option value="Strict" selected="@(Model.SenderCheck.Mode == "Strict")">@T("Stricte")</option>
            </select>
            <div id="sender-check-help" class="form-text">
                <ul class="mb-1">
                    <li><strong>@T("Désactivée")</strong>@T(" : aucune vérification, impression comme avant.")</li>
                    <li><strong>@T("Avertir")</strong>@T(" : impression comme avant, mais l'Historique signale les expéditeurs non vérifiés.")</li>
                    <li><strong>@T("Stricte")</strong>@T(" : seuls les expéditeurs vérifiés sont imprimés ; les autres documents sont archivés sans impression (« Réimprimer » reste possible).")</li>
                </ul>
                @T("Un serveur de messagerie qui ne fournit pas ce verdict donne « non vérifié » : en mode Stricte, aucune impression automatique ne partirait pour ses messages. Essayez d'abord Avertir et consultez la colonne « Impression » de l'Historique. Le verdict n'est fiable que dans la mesure où le serveur qui reçoit les messages l'est.")
            </div>
        </div>
    </section>
    <div class="form-actions mb-4"><button class="btn btn-primary" type="submit">@T("Enregistrer")</button></div>
</form>

<form method="post" asp-page-handler="Password">
    <section class="form-section">
        <h2 class="form-section-title">@T("Sécurité")</h2>
        <p class="form-section-hint">@T("Changer le mot de passe administrateur.")</p>
        @if (Model.PasswordMessage is not null) { <div class="alert @(Model.PasswordOk ? "alert-success" : "alert-danger")" role="@(Model.PasswordOk ? "status" : "alert")">@Model.PasswordMessage</div> }
        <div class="field"><label class="form-label" asp-for="Password.Current">@T("Mot de passe actuel")</label><input class="form-control" asp-for="Password.Current" autocomplete="current-password" /></div>
        <div class="form-grid">
            <div class="field"><label class="form-label" asp-for="Password.New">@T("Nouveau mot de passe (8 caractères minimum)")</label><input class="form-control" asp-for="Password.New" autocomplete="new-password" /></div>
            <div class="field"><label class="form-label" asp-for="Password.Confirm">@T("Confirmer le nouveau mot de passe")</label><input class="form-control" asp-for="Password.Confirm" autocomplete="new-password" /></div>
        </div>
    </section>
    <div class="form-actions mb-4"><button class="btn btn-primary" type="submit">@T("Changer le mot de passe")</button></div>
</form>

<section class="form-section">
    <h2 class="form-section-title">@T("Export et import des règles")</h2>
    <p class="form-section-hint">@T("Exportez les règles, les catégories et les paramètres d'impression dans un fichier JSON, par exemple pour les copier sur un autre PC. Les mots de passe des boîtes mail, les jetons et les agents d'impression ne sont jamais exportés.")</p>
    <p><a class="btn btn-secondary" asp-page="/Settings/Index" asp-page-handler="Export">@T("Exporter les règles")</a></p>
    @if (Model.ImportMessage is not null) { <div class="alert alert-success" role="status">@Model.ImportMessage</div> }
    @if (Model.ImportError is not null) { <div class="alert alert-danger" role="alert">@Model.ImportError</div> }
    @if (Model.ImportAnalysis is { } a && Model.ImportJson is not null)
    {
        <form method="post" asp-page-handler="ImportApply">
            <div class="alert alert-warning" role="alert">
                <strong>@T("Attention : l'import REMPLACE toutes vos règles actuelles, vos catégories et les paramètres d'impression. Cette action est irréversible.")</strong>
                <ul class="mb-0 mt-2">
                    <li>@T("{0} règle(s) et {1} catégorie(s) seront importées.", a.Rules, a.Categories)</li>
                    <li>@T("Les catégories contenant déjà des documents sont conservées même si le fichier ne les contient pas.")</li>
                    @if (a.SkippedNoMailbox.Count > 0) { <li>@T("Règles ignorées, car leur boîte mail n'existe pas ici (les identifiants ne sont pas importés : ajoutez d'abord la boîte, puis réimportez) :") @string.Join(", ", a.SkippedNoMailbox)</li> }
                    @if (a.DeactivatedNoPrinter.Count > 0) { <li>@T("Règles importées mais désactivées, car leur imprimante n'existe pas ici (ajoutez l'imprimante, puis réactivez la règle) :") @string.Join(", ", a.DeactivatedNoPrinter)</li> }
                </ul>
            </div>
            <input type="hidden" name="ImportJson" value="@Model.ImportJson" />
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="import-confirm" name="ImportConfirm" value="true" />
                <label class="form-check-label" for="import-confirm">@T("Je comprends que mes règles actuelles seront remplacées.")</label>
            </div>
            <button class="btn btn-danger" type="submit">@T("Remplacer par ce fichier")</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="ImportPreview" enctype="multipart/form-data">
            <div class="field">
                <label class="form-label" for="import-file">@T("Fichier d'export (.json)")</label>
                <input class="form-control" type="file" id="import-file" name="importFile" accept=".json,application/json" />
            </div>
            <button class="btn btn-secondary mt-2" type="submit">@T("Vérifier le fichier")</button>
        </form>
    }
</section>

<section class="form-section">
    <h2 class="form-section-title">@T("Sauvegarde")</h2>
    <p class="form-section-hint">@T("Une sauvegarde de la base est créée chaque nuit à 02:00 dans le dossier « backups » des documents (14 conservées).")</p>
    <div id="backup-result" aria-live="polite"></div>
    <form method="post" asp-page-handler="Backup" hx-post="@Url.Page("/Settings/Index", "Backup")" hx-target="#backup-result" hx-swap="innerHTML" class="mb-3">
        <button class="btn btn-secondary" type="submit">@T("Sauvegarder maintenant")</button>
    </form>
</section>
</div>

@section Scripts {
<script>
(function () {
    var input = document.getElementById('Input_DocumentsRoot'), panel = document.getElementById('folder-browser');
    var url = '@Url.Page("/Settings/Index", "Browse")';
    document.getElementById('browse-folder').addEventListener('click', function () {
        htmx.ajax('GET', url + '&path=' + encodeURIComponent(input.value), { target: '#folder-browser', swap: 'innerHTML' });
    });
    panel.addEventListener('click', function (e) {
        var pick = e.target.closest('[data-pick]');
        if (pick) { input.value = pick.dataset.pick; panel.innerHTML = ''; input.form.requestSubmit(); }
        else if (e.target.closest('[data-close-browser]')) panel.innerHTML = '';
    });
})();
</script>
}
