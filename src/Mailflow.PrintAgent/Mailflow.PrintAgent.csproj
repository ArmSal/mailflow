<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MailflowPrintAgent</AssemblyName>
    <RootNamespace>Mailflow.Agent</RootNamespace>
    <ApplicationIcon>..\Mailflow.Desktop\Assets\mailflow.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same signed-update verification as Mailflow (BCL only), compiled into the agent. -->
    <Compile Include="..\Mailflow.Application\Updates\UpdateKeys.cs;..\Mailflow.Application\Updates\UpdateManifest.cs;..\Mailflow.Application\Updates\UpdateDownloader.cs" LinkBase="Updates" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailflow.Integration.Tests" />
  </ItemGroup>

</Project>
